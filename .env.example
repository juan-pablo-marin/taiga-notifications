# =============================================================================
# taiga-discord-reminders â€” variables para Discord + tablero web (mismo .env)
# Copia a .env y rellena. No subas .env a git.
# =============================================================================

# --- Discord (solo el contenedor de recordatorios; webhook entrante) ---
# URL completa (empieza por https:// y contiene /api/webhooks/). No pegues solo el token.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890123456789/abcdefgh...
DISCORD_WEBHOOK_URL=

# --- Taiga (API; lectura Ãºnicamente) ---
TAIGA_BASE_URL=
TAIGA_PROJECT_ID=

# Usuario de inicio de sesiÃ³n en Taiga (suele ser el username, no el email).
TAIGA_USERNAME=
TAIGA_PASSWORD=
# TAIGA_AUTH_TOKEN=

# Certificado SSL del servidor Taiga (solo si es autofirmado y falla la conexiÃ³n).
# TAIGA_SSL_VERIFY=false

TAIGA_PROJECT_SLUG=
# TAIGA_WEB_UI_BASE_URL=

TZ=America/Bogota
NOTIFY_ON_EMPTY=false

# Opcional: si estÃ¡ definido, solo se incluyen tareas asignadas a esa persona
# (coincide con el nombre completo en Taiga; no distingue mayÃºsculas).
# TAIGA_NOTIFY_ASSIGNEE=Juan Pablo Marin Otalvaro

# --- Tablero web (FastAPI) ---
# Puerto en TU PC para http://localhost:PUERTO/ (mapea al 8086 interno del contenedor).
# Por defecto 8086. Si Windows dice que el puerto estÃ¡ en uso, prueba 8087 o 18086:
# TAIGA_DASHBOARD_PUBLISH_PORT=8087
TAIGA_DASHBOARD_PORT=8086
# TAIGA_DASHBOARD_BIND=0.0.0.0

# --- Discord (DM por bot para tareas vencidas) ---
# Token del bot (Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Mapa email (Taiga) -> ID de usuario en Discord, en JSON en una sola linea.
# DISCORD_USER_MAP_JSON={"dmvelezp@sena.edu.co":"123456789012345678","jpmarin@sena.edu.co":"234567890123456789"}
DISCORD_USER_MAP_JSON={}
# Correo de la lider que siempre recibe copia
DISCORD_LEAD_EMAIL=dmvelezp@sena.edu.co
# Lista de lideres que reciben reporte diario (separados por coma)
# DISCORD_LEAD_EMAILS=dmvelezp@sena.edu.co,jupamarin@sena.edu.co
DISCORD_LEAD_EMAILS=dmvelezp@sena.edu.co
# Archivo para deduplicar envios por dia (persistente con volumen)
TAIGA_NOTIFY_STATE_FILE=/data/notified_state.json
